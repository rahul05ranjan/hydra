{
  "name": "hydra-nano",
  "version": "0.3.1",
  "description": "Small local models that take the noisy work off your coding agent: git history, test and build digests and OS inspection run on your machine, and only the lines that matter reach Claude Code, Codex, Cursor, OpenCode, Gemini CLI or Antigravity. Skill, MCP server and hooks.",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "gemini-cli",
    "antigravity",
    "mcp",
    "mcp-server",
    "agent-skill",
    "ai-agents",
    "coding-agent",
    "local-llm",
    "llama.cpp",
    "token-saving",
    "context-window",
    "git",
    "test-runner",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "rahul05ranjan",
  "homepage": "https://github.com/rahul05ranjan/hydra#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahul05ranjan/hydra.git"
  },
  "bugs": {
    "url": "https://github.com/rahul05ranjan/hydra/issues"
  },
  "type": "module",
  "bin": {
    "hydra-nano": "skills/hydra/scripts/install.mjs",
    "hydra": "skills/hydra/scripts/hydra.mjs",
    "hydra-install": "skills/hydra/scripts/install.mjs"
  },
  "scripts": {
    "test": "node --test",
    "eval": "node evals/run.mjs",
    "eval:build": "node evals/git1/build.mjs",
    "eval:test": "node evals/test_logs/run.mjs",
    "eval:test:build": "node evals/test_logs/build.mjs",
    "eval:read": "node evals/read/run.mjs",
    "eval:read:build": "node evals/read/build.mjs",
    "eval:files": "node evals/files/run.mjs",
    "eval:strict": "node evals/trial/strict_trial.mjs",
    "eval:frontier:prepare": "node evals/trial/frontier_trial.mjs",
    "eval:frontier": "node evals/trial/frontier_trial.mjs --run",
    "eval:real:prepare": "node evals/trial/real_repo_trial.mjs",
    "eval:real": "node evals/trial/real_repo_trial.mjs --run",
    "dashboard": "node dashboard/server.mjs",
    "stats:readme": "node evals/usage/readme_stats.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "skills/hydra"
  ]
}
