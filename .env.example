# Copy these entries into the root .env. Keep existing Cloudflare entries.
# Never commit .env or paste tokens into chat.

# Kaggle: https://www.kaggle.com/settings/api
KAGGLE_USERNAME=your-kaggle-username
KAGGLE_API_TOKEN=

# Optional legacy Kaggle API key (use instead of KAGGLE_API_TOKEN).
# KAGGLE_KEY=

# Hugging Face publication. Leave blank if already logged in with hf auth login.
HF_TOKEN=

# Cloudflare Workers AI: development assistance and independent training-data drafts.
# Token permission: Account / Workers AI / Edit for the account below.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_DEVELOPMENT_MODEL=@cf/zai-org/glm-5.3
# Optional custom OpenAI-compatible base URL; blank uses this account's Workers AI endpoint.
CLOUDFLARE_DEVELOPMENT_BASE_URL=
